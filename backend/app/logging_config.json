{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "uvicorn_default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": false
    },
    "app_fmt": {
      "format": "%(asctime)s %(levelname)-8s %(name)s — %(message)s",
      "datefmt": "%H:%M:%S"
    }
  },
  "handlers": {
    "uvicorn_handler": {
      "formatter": "uvicorn_default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "app_handler": {
      "formatter": "app_fmt",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn":        { "handlers": ["uvicorn_handler"], "level": "INFO",  "propagate": false },
    "uvicorn.error":  { "handlers": ["uvicorn_handler"], "level": "INFO",  "propagate": false },
    "uvicorn.access": { "handlers": ["uvicorn_handler"], "level": "INFO",  "propagate": false },
    "app":            { "handlers": ["app_handler"],     "level": "INFO",  "propagate": false },
    "alembic":        { "handlers": ["app_handler"],     "level": "INFO",  "propagate": false },
    "sqlalchemy.engine": { "handlers": ["app_handler"],  "level": "WARNING", "propagate": false }
  },
  "root": { "level": "INFO", "handlers": ["app_handler"] }
}
