# LLM: openai | gemini | yandex | gigachat | mock
# For Russia / quota issues: use yandex, gigachat, or mock (no external LLM bill).
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
GEMINI_API_KEY=

# --- YandexGPT (Yandex Cloud Foundation Models) ---
# Create a service account API key in the console; folder id from cloud folder.
# Docs: https://yandex.cloud/en/docs/foundation-models/
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional full URI, e.g. gpt://<folder_id>/yandexgpt/latest
YANDEX_MODEL_URI=
# YANDEX_COMPLETION_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

# --- GigaChat (Sber) ---
# Register app at https://developers.sber.ru/ — client id + secret, scope GIGACHAT_API_PERS
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
# LLM_MODEL=GigaChat

# CORS (comma-separated origins for production)
CORS_ORIGIN=http://localhost:5173

# Chat turns per session (cost guard)
MAX_CHAT_TURNS_PER_SESSION=50

# PostgreSQL (async). Leave empty for in-memory-only / unit tests.
# Docker Compose sets this automatically for the backend service.
# Local: postgresql+asyncpg://gantt:gantt@localhost:5432/gantt
DATABASE_URL=
# RUN_MIGRATIONS_ON_START=true runs Alembic on API startup (default in Settings).

# --- Operational limits (testing scope) ---
# Hard timeout for any LLM call (seconds). On expiry chat returns 504 llm_timeout.
LLM_REQUEST_TIMEOUT_SECONDS=60
# Maximum tasks in a single plan (applies to seed, /upload Excel import, and AddTask via chat).
MAX_TASKS_TOTAL=200
# Maximum commands in a single LLM batch; over this -> Clarify (prevents prompt-injection mass ops).
MAX_COMMANDS_PER_BATCH=50
# Bulk-delete confirmation threshold; over this require user to repeat with phrase YES_DELETE_BULK.
MAX_DELETES_PER_BATCH=5
